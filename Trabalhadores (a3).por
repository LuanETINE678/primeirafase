programa {
  funcao inicio() {
    
    inteiro clt, estagiarios, pj, devs
  // entrada de dados

  escreva ("Número de trabalhadores CLT: ")
  leia (clt)
  escreva("Número de estágiarios: ")
  leia(estagiarios)
  escreva ("Número de PJ: ")
  leia(pj) 

  // processamento

  devs = clt + estagiarios + pj

  // saída
  escreva ("Numero totais de devs: ") 
  escreva (devs) 
    
  }
}
