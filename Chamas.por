programa {
  funcao inicio() {
    cadeia eu, ainda, estou, aqui
    cadeia me, deixe, queimar, nesse, lugar 
    escreva("Você ainda está aqui?\n")
    leia (eu) 
    escreva("Sim, eu sempre estive aqui\n")
    leia(me)
    escreva ("Por que você teve que me deixar?\n") 
    leia (ainda)
    escreva ("Eu levei o pecado da carne ao fogo, Maria.\n")
    leia (deixe)
    escreva ("O passado não foi apagado\n")
    leia (estou)
    escreva("Claro que foi, você nunca entenderia o que eu fiz\n")
    leia (queimar)
    escreva("Você era pra ser melhor que isso\n")
    leia (aqui)
    escreva ("Eu sou bem melhor que todas as coisas\n")
    leia (nesse)
    escreva("é tudo isso que você consegue fazer?\n")
    leia(lugar)
    escreva("Eu sou capaz de fazer muito mais que isso\n")
  }
}
