programa {
  funcao inicio() {
   inteiro inicio, fim, total

   escreva ("quantidade incial de laranjas: ")
   leia (inicio)
   escreva ("quantidade de laranjas vendidas: ")
   leia (fim)

   // processamento
   escreva ("Numero final de laranjas do dia: ")
   total = inicio - fim 

   // saida
   
   escreva (total)
   
  }
}
