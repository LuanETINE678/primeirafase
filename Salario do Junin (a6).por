programa {
  funcao inicio() {

    inteiro salario, dias, total

    // entrada de dados
    escreva ("Salario ganho mensalmente: ")
    leia (salario)
    escreva ("Dias trabalhados: ")
    leia (dias)

    // processsamento 

    total = salario/dias

    // saida
    escreva ("Ganho por dias: ")
    escreva (total) 
   escreva ("\nNota do desenvolvedor: Nessa situação, eu optei em deixar os dias do mês sendo 18 a 22, já que sem feriados e finais de semana, acaba ficando assim mesmo.")

  }
}
