programa {
  funcao inicio() {
    // Inicio 
   inteiro pesoBruto, tara, carga
    // processo
   escreva ("Peso(kg) total do caminhão: ")
   leia (pesoBruto)
   escreva ("tara(Kg) do caminhão: ")
   leia (tara)
   escreva ("Peso de carga total: ")
   carga = pesoBruto - tara
   
    // saida
    escreva (carga)
  }
}
