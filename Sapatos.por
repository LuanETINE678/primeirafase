programa {
  funcao inicio() {
    // entendimento do problema 
    // calcular o valor de vale trocas e, considerando o preço e quantidade de calçados 
    // infos e variaveis 
    real sapato, troca, resultado

    // entrada de dados

    escreva ("Preço do seu sapato atual: ")
    leia (sapato)
    escreva ("trocas a serem realizadas: ")
    leia (troca) 

    
    // processamento
     escreva ("resultado: ")
     
    // saidas
    resultado = sapato * troca
    escreva (resultado)


 }

}
