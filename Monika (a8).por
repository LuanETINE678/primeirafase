programa {
  funcao inicio() {
    // inicio
    inteiro chance, n 
    
    // processo
   escreva("quantas vezes você usou o celular?: ")
   leia (n)
   escreva("Sua porcentagem de passar no teste: ")
   chance = (0.1 /(1 + 500 * n)) * 1000000
  
    // saída
    escreva (chance)
    escreva ("%")
    
   
   
  }
}
