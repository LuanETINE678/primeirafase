programa {
  funcao inicio() {
    // entendimento do problema
     // calcular o horario de retorno do intervalo
  // infos e variaveis 
  inteiro hora, minuto 
  // entrada de dados 
  escreva("hora do começo: ")
  leia(hora) 
   escreva ("minuto que começa: ")
   leia(minuto) 
  // processamento
  minuto = minuto + 20 
  // saida 
  escreva ("recreio termina ")
  escreva(hora)
  escreva(":")
  escreva(minuto) 
  escreva("\no que acontece com quem chega depois do horario? ")
   

  }
}
